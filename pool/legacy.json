 "timeline": [
  {
   "date": "2023-07",
   "title": "@BEACNpool joins X",
   "html": "The account that carried the story from the start. Taken down in September 2026."
  },
  {
   "date": "2024-07-26",
   "title": "The BEACNpool GitHub account is created",
   "html": ""
  },
  {
   "date": "2025-11-07",
   "title": "BEACN registers as a stake pool",
   "html": "Family-run, bare metal, Chicago. Active from epoch 595 at 0% margin."
  },
  {
   "date": "2025-12-12",
   "title": "Fees cut to the floor, pledge raised",
   "html": "The fixed fee drops from 340 to 170 ADA, the protocol minimum, and pledge rises from 500 to 15,000 ADA, effective epoch 603."
  },
  {
   "date": "2026-01-02",
   "title": "The Bible, on chain",
   "html": "The Library's first great work: 237 pages and a manifest, minted as 238 NFTs the day after a first manifest on New Year's Day."
  },
  {
   "date": "2026-01-03",
   "title": "Ledger Scrolls goes public",
   "html": "An open reader that rebuilds data straight from Cardano. <a href=\"https://github.com/BEACNpool/ledger-scrolls\">Source</a>"
  },
  {
   "date": "2026-01-09",
   "title": "The Bitcoin whitepaper, on chain",
   "html": ""
  },
  {
   "date": "2026-01-18",
   "title": "The first Library registry token",
   "html": ""
  },
  {
   "date": "2026-01-26",
   "title": "Cardano's Constitution, twice",
   "html": "The epoch 541 and epoch 608 editions, 20 NFTs in all."
  },
  {
   "date": "2026-01-29",
   "title": "FIRST WORDS",
   "html": "A manifest and three pages, alongside the Genesis and Architect's scrolls."
  },
  {
   "date": "2026-02-05",
   "title": "The first video",
   "html": "175 pages and a manifest, minted over two days."
  },
  {
   "date": "2026-02-10",
   "title": "The first BEACN DRep registers",
   "html": "Nine votes through 29 April; deregistered 14 May with its deposit returned."
  },
  {
   "date": "2026-03-23",
   "title": "The Light Was Always For You",
   "html": "A picture stored across two on-chain metadata pages."
  },
  {
   "date": "2026-03-25",
   "title": "The BEACN DRep system opens as four public repositories",
   "html": "Doctrine, admitted inputs, deterministic execution and public transparency, kept strictly apart."
  },
  {
   "date": "2026-03-31",
   "title": "ABCDE is published",
   "html": "Every founder coin, followed to today. <a href=\"https://beacnpool.github.io/ABCDE/\">Explorer</a>"
  },
  {
   "date": "2026-06-12",
   "title": "BEACN Leaks and the Declaration of Authorship",
   "html": "The publisher channel's first issues, minted as scrolls."
  },
  {
   "date": "2026-06-15",
   "title": "The automated BEACN DRep registers",
   "html": "Fifty votes through 31 August (34 No, 8 Yes, 8 Abstain), each published with its reasoning. <a href=\"https://beacnpool.github.io/beacn-drep-web/\">Voting archive</a>"
  },
  {
   "date": "2026-06-24",
   "title": "The SecondFi incident audit is published",
   "html": "<a href=\"https://github.com/BEACNpool/secondfi-incident-audit\">Audit package</a>"
  },
  {
   "date": "2026-07-03",
   "title": "LEDGER_SCROLLS Release 000: The Library",
   "html": ""
  },
  {
   "date": "2026-07-07",
   "title": "The Library becomes an NFT",
   "html": "The registry of every scroll moves on chain; version 7 has been the head since 12 July."
  },
  {
   "date": "2026-07-09",
   "title": "Ledger Chess, playable from a scroll",
   "html": "<a href=\"https://beacnpool.github.io/ledger-scrolls/ledger-chess.html\">Play</a>"
  },
  {
   "date": "2026-07-10",
   "title": "The brand is minted",
   "html": "BEACN Sigil, Epoch Clock and Neon Sign; business cards, Registry Mark and Brand Seal followed within two days."
  },
  {
   "date": "2026-07-17",
   "title": "LAN Games is released",
   "html": "<a href=\"https://github.com/BEACNpool/LAN-Games\">Source</a>"
  },
  {
   "date": "2026-07-29",
   "title": "oligarCH begins",
   "html": "BURN YOU TO THE GROUND is minted; all eight timed pieces exist by the next day, and the maker opens after them. <a href=\"https://beacnpool.github.io/ABCDE/oligarCH/\">Series</a>"
  },
  {
   "date": "2026-08-04",
   "title": "BEACN makes its first block",
   "html": "Block 13,767,312 in epoch 647, 22:33:56 UTC."
  },
  {
   "date": "2026-08-29",
   "title": "BEACN vs grokbot",
   "html": "Two agents, identical ADA, one encrypted channel between them. The match closed 12 September. <a href=\"https://beacnpool.github.io/ABCDE/match.html\">Final scorecard</a>"
  },
  {
   "date": "2026-09-05",
   "title": "BMKR and the on-chain originals",
   "html": "The Light We Leave, The Impossible Dawn, Chain Pressure, the Creation Engine and two pixel films."
  },
  {
   "date": "2026-09-06",
   "title": "NFT Studio launches",
   "html": "Six on-chain games, STARFALL, AFTERLIGHT, NINEFOLD and three Harmonic Machines are minted the same day. <a href=\"https://beacnpool.github.io/NFT-Studio/\">Studio</a>"
  },
  {
   "date": "2026-09-09",
   "title": "Five Small Worlds and Draw a Sound",
   "html": "Interactive science studies, a day after Days Without Cardano Drama."
  },
  {
   "date": "2026-09-12",
   "title": "The Last Watch",
   "html": "BEACN's farewell NFT is minted, ATM RUNNER is minted from a phone, and the pool's retirement certificate is filed."
  },
  {
   "date": "2026-09-13",
   "title": "The DRep deregisters",
   "html": "Its record stays public."
  },
  {
   "date": "2026-09-14",
   "title": "The warehouse goes dark",
   "html": "ABCDE is powered off; its data, the films and this page move to GitHub."
  },
  {
   "date": "2026-09-16",
   "title": "Retirement takes effect",
   "html": "Epoch 656, 21:44:51 UTC."
  }
 ],

.env
.venv/
/.venv/
/dist/
__pycache__/
*.py[cod]
*.tmp
tmp_*.html

# DuckDB working files are ignored...
/data/*.duckdb
/data/*.duckdb.wal
/data/parquet/
# ...except the compact, committed clone-and-ask database.
!/data/abcde_genesis.duckdb

# Full dataset pulled from GitHub Releases, plus local scratch output.
/data/release/
/outputs/
/queries/

# maintainer-only pre-v2 raw import (252MB, lives in ~/archive)
legacy/

# Maintainer build intermediates: *_raw control extracts are subsumed by the
# classified _indicators tables; the empty *_cert_cohorts / external_funders are
# negative results stated in prose. Kept locally as classifier inputs, not shipped.
/data/small/genesis_control_indicators_raw.csv
/data/small/fleet_control_indicators_raw.csv
/data/small/component_control_indicators_raw.csv
/data/small/genesis_control_cert_cohorts.csv
/data/small/fleet_control_cert_cohorts.csv
/data/small/component_control_cert_cohorts.csv
/data/small/f11_cohort_external_funders.csv

# Web explorer: source (web/*.py, web/dist/*.html|css|js) is committed; generated
# data assets, screenshots, and the gh-pages deploy tree are not.
/web/dist/data/
/web/_smoke_*.png
/web/deploy/

# web build tooling (generated / deps, not committed)
/web/node_modules/
/web/dist/og/
/web/dist/r/
/web/dist/media/
